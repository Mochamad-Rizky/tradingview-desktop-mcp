# Configuration for tradingview-desktop-mcp. Copy this file to .env and load it with
# `node --env-file=.env` or your process manager. An MCP client can set them in its "env" block.
#
# Every variable is optional except TV_MCP_AUTH_TOKEN, which the HTTP transport requires. An empty
# value counts as unset, so this file can be loaded as it is. A command-line flag beats its
# variable, and a variable beats the default shown here.

# Host of TradingView's debug port; loopback only: 127.0.0.1, localhost or ::1. Flag: --cdp-host
TV_CDP_HOST=127.0.0.1

# Port of TradingView's debug port, 1 to 65535. Flag: --cdp-port
TV_CDP_PORT=9222

# Path of the TradingView Desktop app. Empty means auto-detect. Flag: --app-path
TV_APP_PATH=

# Milliseconds to wait for the debug port after launching TradingView, 1000 or more.
TV_LAUNCH_TIMEOUT_MS=60000

# Milliseconds to wait for one call into TradingView before it fails with TIMEOUT, 1000 or more.
TV_CALL_TIMEOUT_MS=15000

# Log level, written to stderr: trace, debug, info, warn, error, fatal or silent. Flag: --log-level
TV_MCP_LOG_LEVEL=info

# Transport: stdio, or http (Streamable HTTP, needs TV_MCP_AUTH_TOKEN). Flag: --transport
TV_MCP_TRANSPORT=stdio

# Address the HTTP transport and the dashboard listen on. Flag: --host
TV_MCP_HTTP_HOST=127.0.0.1

# Port the HTTP transport and the dashboard listen on, 1 to 65535. Flag: --port
TV_MCP_HTTP_PORT=8787

# Secret for the HTTP transport, required for http, no flag. Generate one: openssl rand -hex 32
TV_MCP_AUTH_TOKEN=

# Tool profile: core, full or readonly (readonly suits a public tunnel). Flag: --profile
TV_MCP_PROFILE=full

# Comma-separated tool name globs, such as chart_*,data_get_ohlcv. Empty means all. Flag: --tools
TV_MCP_TOOLS=

# Allow the ui_evaluate tool to run JavaScript inside TradingView: true or false. Flag: --allow-eval
TV_MCP_ALLOW_EVAL=false

# Dashboard: true or false. Empty: on for http, off for stdio. Flags: --dashboard, --no-dashboard
TV_MCP_DASHBOARD=
