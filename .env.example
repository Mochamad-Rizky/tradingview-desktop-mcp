# Configuration for tradingview-desktop-mcp. Copy this file to .env and load it with
# `node --env-file=.env` or your process manager. An MCP client can set them in its "env" block.
#
# Every variable is optional except TV_MCP_AUTH_TOKEN, which the HTTP transport and the dashboard
# require. An empty value counts as unset, so this file can be loaded as it is. A command-line
# flag beats its variable, and a variable beats the default shown here.

# Host of TradingView's debug port; loopback only: 127.0.0.1, localhost or ::1. Flag: --cdp-host
TV_CDP_HOST=127.0.0.1

# Port of TradingView's debug port, 1 to 65535. Flag: --cdp-port
TV_CDP_PORT=9222

# Path of the TradingView Desktop app. Empty means auto-detect. Flag: --app-path
TV_APP_PATH=

# Milliseconds to wait for the debug port after launching TradingView, 1000 or more.
TV_LAUNCH_TIMEOUT_MS=60000

# Milliseconds to wait for one call into TradingView before it fails with TIMEOUT, 1000 or more.
TV_CALL_TIMEOUT_MS=15000

# Log level, written to stderr: trace, debug, info, warn, error, fatal or silent. Flag: --log-level
TV_MCP_LOG_LEVEL=info

# Transport: stdio, or http (Streamable HTTP, needs TV_MCP_AUTH_TOKEN). Flag: --transport
TV_MCP_TRANSPORT=stdio

# Address the HTTP transport and the dashboard listen on. Flag: --host
TV_MCP_HTTP_HOST=127.0.0.1

# Port the HTTP transport and the dashboard listen on, 1 to 65535. Flag: --port
TV_MCP_HTTP_PORT=8787

# Secret for the HTTP transport, required for http, no flag. Use at least 32 random characters,
# such as the output of: openssl rand -hex 32
TV_MCP_AUTH_TOKEN=

# Extra Host names the HTTP transport and the dashboard accept besides their own address, such as a
# tunnel's public host: abc.ngrok.app, mymac.local:8443 or https://abc.ngrok.app/, comma-separated.
# A host without a port also matches :443 and :80; a host with another port matches only that
# port. Ports 80 and 443 count as no port. Refused: a path, a query, a fragment, a user name or
# password, a wildcard, and an http:// URL without a port other than 80 or 443. Behind a tunnel,
# prefer TV_MCP_PROFILE=readonly. Flag: --allowed-hosts
TV_MCP_ALLOWED_HOSTS=

# Tool profile: core, full or readonly (readonly suits a public tunnel). Flag: --profile
TV_MCP_PROFILE=full

# Comma-separated tool name globs, such as chart_*,data_get_ohlcv, or all (the same as empty).
# Flag: --tools
TV_MCP_TOOLS=all

# Allow the ui_evaluate tool to run JavaScript inside TradingView: true or false. Flag: --allow-eval
TV_MCP_ALLOW_EVAL=false

# Web dashboard: true or false. Empty: on for http, off for stdio. Flags: --dashboard, --no-dashboard
# With stdio, true starts the dashboard on its own listener at TV_MCP_HTTP_HOST:TV_MCP_HTTP_PORT, and
# it then needs TV_MCP_AUTH_TOKEN: without one, or when the port is taken, the dashboard stays off
# with a warning and the MCP server runs on.
TV_MCP_DASHBOARD=
