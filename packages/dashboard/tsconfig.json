{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom/vitest"],
    "paths": {
      "@/*": ["./src/*"],
      "@contract": ["../server/src/transports/dashboard/contract.ts"]
    },
    "allowImportingTsExtensions": true,
    // playwright.config.ts reads the constants of the end-to-end tests' plain JavaScript fixtures,
    // which e2e/tsconfig.json checks.
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "src",
    "dev-proxy.ts",
    "dev-proxy.test.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
