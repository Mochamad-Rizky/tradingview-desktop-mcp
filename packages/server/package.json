{
  "name": "tradingview-desktop-mcp",
  "version": "0.1.3",
  "description": "MCP server that controls the TradingView Desktop app over the Chrome DevTools Protocol",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tradingview",
    "trading",
    "charting",
    "claude",
    "cursor",
    "ai",
    "chrome-devtools-protocol"
  ],
  "homepage": "https://github.com/Mochamad-Rizky/tradingview-desktop-mcp#readme",
  "bugs": "https://github.com/Mochamad-Rizky/tradingview-desktop-mcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mochamad-Rizky/tradingview-desktop-mcp.git",
    "directory": "packages/server"
  },
  "license": "MIT",
  "author": {
    "name": "Mochamad Rizky",
    "url": "https://github.com/Mochamad-Rizky"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "tradingview-desktop-mcp": "dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && node scripts/copy-dashboard.mjs",
    "prepack": "node scripts/prepare-package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:coverage": "vitest run --project unit --project integration --coverage",
    "re:probe": "tsx scripts/re/probe.ts",
    "re:record": "tsx scripts/re/record-fixtures.ts",
    "docs:clients": "tsx scripts/docs/clients.ts",
    "docs:examples": "tsx scripts/docs/examples.ts",
    "docs:tools": "tsx scripts/docs/tools.ts"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "^0.34.0",
    "@types/node": "^20.19.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "chrome-remote-interface": "^0.34.0",
    "devtools-protocol": "^0.0.1721318",
    "picocolors": "^1.1.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  }
}
