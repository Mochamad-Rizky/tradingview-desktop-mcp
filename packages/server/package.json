{
  "name": "tradingview-desktop-mcp",
  "version": "0.1.0",
  "description": "MCP server that controls the TradingView Desktop app over the Chrome DevTools Protocol",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "tradingview-desktop-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:coverage": "vitest run --project unit --project integration --coverage"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  }
}
