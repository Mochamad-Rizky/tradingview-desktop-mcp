{
  "name": "tradingview-mcp-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "build": "pnpm --filter tradingview-desktop-mcp-dashboard build && pnpm --filter tradingview-desktop-mcp build",
    "dev:dashboard": "pnpm --filter tradingview-desktop-mcp-dashboard dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r --if-present test",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:integration": "pnpm -r --if-present test:integration",
    "test:e2e": "pnpm --filter tradingview-desktop-mcp test:e2e",
    "test:e2e:dashboard": "pnpm --filter tradingview-desktop-mcp-dashboard test:e2e",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "re:probe": "pnpm --filter tradingview-desktop-mcp re:probe",
    "re:record": "pnpm --filter tradingview-desktop-mcp re:record",
    "docs:clients": "pnpm --filter tradingview-desktop-mcp docs:clients",
    "docs:examples": "pnpm --filter tradingview-desktop-mcp docs:examples",
    "docs:tools": "pnpm --filter tradingview-desktop-mcp docs:tools",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
